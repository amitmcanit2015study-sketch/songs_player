<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh_online"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/search_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:layout_marginBottom="4dp"
            app:boxCornerRadiusBottomEnd="@dimen/corner_radius_large"
            app:boxCornerRadiusBottomStart="@dimen/corner_radius_large"
            app:boxCornerRadiusTopEnd="@dimen/corner_radius_large"
            app:boxCornerRadiusTopStart="@dimen/corner_radius_large"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="1dp"
            app:endIconMode="clear_text"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_online"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant"
                android:hint="Search online songs, artists, mixes..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category Chips matching reference app (All, Indian classical music, 90s Hits, Sufi Ghazal, Lo fi, Deep House, etc.) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_genres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="All" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_indian_classical"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Indian classical music" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_90s_hits"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="90's Hindi Hits" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sufi_ghazal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Sufi Ghazal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_deep_house"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deep House Mix" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lofi"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lo fi Beats" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_focus_work"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Focus &amp; Work" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bollywood"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bollywood Mashup" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Section Header -->
        <TextView
            android:id="@+id/tv_online_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:text="Suggested Online Songs"
            android:textColor="?attr/colorOnBackground"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Online Songs List with Visible Scrollbar -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_online_songs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:scrollbarThumbVertical="@color/primary"
            android:scrollbarSize="4dp"
            android:fadeScrollbars="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_song" />

        <!-- Bottom Loading Indicator when scrolling for more items -->
        <ProgressBar
            android:id="@+id/progress_loading_more"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tv_empty_online"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:gravity="center"
            android:text="No online songs found for this selection"
            android:textColor="?attr/colorOutline"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
