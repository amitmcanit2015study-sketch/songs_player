<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sleep_timer"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/text_headline"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_timer_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Turn off playback automatically after timer expires"
        android:textColor="?attr/colorOutline"
        android:textSize="@dimen/text_small" />

    <!-- Timer Preset Chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_15m"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 Mins" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_30m"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 Mins" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_45m"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45 Mins" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_60m"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60 Mins" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Custom Timer Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_custom_minutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:hint="Custom minutes"
        app:boxStrokeColor="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_custom_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_timer_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/btn_timer_stop"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:text="Turn Off"
            android:textColor="@color/error" />

        <Button
            android:id="@+id/btn_timer_set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:backgroundTint="@color/primary"
            android:text="Set Timer" />
    </LinearLayout>

</LinearLayout>
