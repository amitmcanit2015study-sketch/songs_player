<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12131A"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_about"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#FFFFFF"
        app:title="About"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Center App Icon -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#232433"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#1FFFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_launcher_foreground" />
            </com.google.android.material.card.MaterialCardView>

            <!-- App Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Songs Player"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- App Version -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="v1.0.0 (Production Build)"
                android:textColor="#A0A2B8"
                android:textSize="13sp" />

            <!-- Info Container Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#1C1D27"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#1FFFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.25"
                        android:text="Songs Player is a free, modern online and offline music player designed for a fast, simple, and seamless audio experience. Easily stream, browse, and manage your songs and downloads with a clean interface, smooth performance, and high-fidelity audio at its core."
                        android:textColor="#E0E2EC"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Developed by: Amit Bharat"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Company: Rooys Soft Tech"
                        android:textColor="#D2D4E4"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Email: rooyssofttech2020@gmail.com"
                        android:textColor="#D2D4E4"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Share App Button (Grey Capsule) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_app"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#2A2B3D"
                android:text="Share App"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

            <!-- Send Feedback Button (Outlined Capsule) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_feedback"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Send Feedback"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:cornerRadius="26dp"
                app:strokeColor="#4E5066"
                app:strokeWidth="1dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="100% Free • No Ads • Zero Tracking"
                android:textColor="#74768B"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
