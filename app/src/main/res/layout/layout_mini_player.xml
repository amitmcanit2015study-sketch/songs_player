<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mini_player_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player_height"
    android:background="@drawable/bg_mini_player"
    android:elevation="6dp"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingEnd="@dimen/spacing_medium">

    <!-- Playback Progress Indicator on Mini Player Top -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/mini_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:max="1000"
        app:indicatorColor="@color/primary"
        app:trackColor="#33FFFFFF"
        app:trackThickness="2.5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Album Art -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/mini_album_art"
        android:layout_width="@dimen/album_art_small"
        android:layout_height="@dimen/album_art_small"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_album_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.SongsPlayer.Small"
        app:layout_constraintTop_toBottomOf="@id/mini_progress_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Text Container (Title + Artist) -->
    <LinearLayout
        android:id="@+id/mini_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_small"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@id/mini_album_art"
        app:layout_constraintBottom_toBottomOf="@id/mini_album_art"
        app:layout_constraintStart_toEndOf="@id/mini_album_art"
        app:layout_constraintEnd_toStartOf="@id/mini_favorite_button">

        <TextView
            android:id="@+id/mini_song_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="Song Title"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mini_song_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Artist Name"
            android:textColor="#B0B3C7"
            android:textSize="@dimen/text_small" />
    </LinearLayout>

    <!-- Favorite Button -->
    <ImageButton
        android:id="@+id/mini_favorite_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Favorite"
        android:src="@drawable/ic_favorite_border"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mini_play_pause_button" />

    <!-- Play / Pause Button -->
    <ImageButton
        android:id="@+id/mini_play_pause_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_player_circle"
        android:contentDescription="@string/play"
        android:src="@drawable/ic_play"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mini_next_button" />

    <!-- Next Button -->
    <ImageButton
        android:id="@+id/mini_next_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/next"
        android:src="@drawable/ic_next"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
